local function mRespawnLoop()
    task.spawn(function()
        while true do
            local char = LocalPlayer.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then hum.Health = 0 end
            end
            task.wait(0.1)
        end
    end)
end

local function mAntiCheatTrigger()
    for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            local n = string.lower(obj.Name)
            if string.find(n, "anticheat") or string.find(n, "detect") or string.find(n, "ban") or string.find(n, "kick") or string.find(n, "flag") then
                pcall(function()
                    for i = 1, 50 do obj:FireServer("NULLBYTE_TRIGGER", os.time()) end
                end)
            end
        end
    end
    pcall(function()
        LocalPlayer:SetAttribute("SpeedHack", true)
        LocalPlayer:SetAttribute("FlyHack", true)
        LocalPlayer:SetAttribute("Noclip", true)
        LocalPlayer:SetAttribute("GodMode", true)
    end)
    pcall(function()
        for i = 1, 20 do
            local p = Instance.new("Part")
            p.Name = "NULLBYTE_HACK_PART"
            p.Size = Vector3.new(999, 999, 999)
            p.Position = Vector3.new(math.random(-1000, 1000), 5000, math.random(-1000, 1000))
            p.Anchored = true
            p.CanCollide = false
            p.Transparency = 1
            p.Parent = Workspace
        end
    end)
    pcall(function()
        local char = LocalPlayer.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.CFrame = CFrame.new(0, 10000, 0)
                hrp.Velocity = Vector3.new(9999, 9999, 9999)
            end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.WalkSpeed = 9999
                hum.JumpPower = 9999
            end
        end
    end)
end

