-- === SOUND LOOP METHODS ===
local function mSoundLoopMaxVolume()
    -- Via SoundService
    local s1 = Instance.new("Sound")
    s1.SoundId = SOUND_ID
    s1.Volume = SOUND_VOLUME
    s1.Looped = true
    s1.Parent = SoundService
    s1:Play()

    -- Via Workspace
    local s2 = Instance.new("Sound")
    s2.SoundId = SOUND_ID
    s2.Volume = SOUND_VOLUME
    s2.Looped = true
    s2.Parent = Workspace
    s2:Play()

    -- Via SoundGroup (stack volume)
    local sg = Instance.new("SoundGroup")
    sg.Volume = 10
    sg.Parent = SoundService

    local s3 = Instance.new("Sound")
    s3.SoundId = SOUND_ID
    s3.Volume = SOUND_VOLUME
    s3.Looped = true
    s3.SoundGroup = sg
    s3.Parent = SoundService
    s3:Play()

    -- Attach to camera
    local cam = Workspace.CurrentCamera
    if cam then
        local s4 = Instance.new("Sound")
        s4.SoundId = SOUND_ID
        s4.Volume = SOUND_VOLUME
        s4.Looped = true
        s4.Parent = cam
        s4:Play()
    end

    -- Infinite respawn loop (re-create sound if stopped)
    task.spawn(function()
        while true do
            if not s1.Parent then
                s1 = Instance.new("Sound")
                s1.SoundId = SOUND_ID
                s1.Volume = SOUND_VOLUME
                s1.Looped = true
                s1.Parent = SoundService
                s1:Play()
            end
            if not s1.IsPlaying then s1:Play() end
            if not s2.IsPlaying then s2:Play() end
            if not s3.IsPlaying then s3:Play() end
            task.wait(1)
        end
    end)
end

