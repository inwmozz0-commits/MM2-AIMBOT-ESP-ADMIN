                    Position = Vector3.new(math.random(-1000, 1000), math.random(-1000, 1000), math.random(-1000, 1000)),
                    Orientation = Vector3.new(math.random(-360, 360), math.random(-360, 360), math.random(-360, 360))
                }):Play()
